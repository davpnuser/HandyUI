<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<UseWindowsForms>True</UseWindowsForms>
	<NoWarn>$(NoWarn);NU1701</NoWarn>
	<AssemblyVersion>1.0.53.26255</AssemblyVersion>

	<Title>HandyUI.WinForms</Title>
	<Description>Platform-agnostic Code-Only C# UI framework powered by SkiaSharp.</Description>
	<PackageReleaseNotes>(NuGet) Release notes for:
 - HandyUI.Core (v1.0.50.26254)
 - HandyUI.WinForms (v1.0.52.26254)

Changes
 - Made retained positioning mode on by default. (Child-Parent positioning)

Improvements &amp; Bug Fixes
 - Fixed some control bugs.
 - Made controls consistent.
 - Made controls work with retained positioning mode.
 - Made the Resource Manager platform-agnostic.

New Features &amp; UI Controls
 - Added new controls: CheckBox, ProgressBar, Slider, TextBox, and Frame
 - Created the Resource Manager Helper.</PackageReleaseNotes>
	<PackageTags>ui;framework;skiasharp;code-only;gui;rendering</PackageTags>
	<PackageId>HandyUI.WinForms</PackageId>
	<Version>$(AssemblyVersion)</Version>
	<Authors>davpnuser</Authors>
	<PackageIcon>HandyUI-Logo.png</PackageIcon>
	<NeutralLanguage>en</NeutralLanguage>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/davpnuser/HandyUI/</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/davpnuser/HandyUI/</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Users\Ubeyde\Downloads\HandyUI-Logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandyUI.Core\HandyUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="HandyUI-Logo.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
