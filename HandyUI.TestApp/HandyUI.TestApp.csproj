<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>False</UseWindowsForms>
	<NoWarn>$(NoWarn);NU1701</NoWarn>
	<AssemblyVersion>1.0.324.26261</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\HandyUI-SmallIcon-Tt.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <PackagePath>\</PackagePath>
      <Pack>true</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandyUI.SilkNet\HandyUI.SilkNet.csproj" />
  </ItemGroup>

</Project>
