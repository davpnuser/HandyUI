<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AssemblyVersion>2.2.0</AssemblyVersion>

	<Title>HandyUI.Controls</Title>
	<Description>Platform-agnostic-at-its-core code-only C# UI framework powered by SkiaSharp.</Description>
	<PackageReleaseNotes>To see the release changelog, view the CHANGELOG.md file in the HandyUI GitHub repository root.</PackageReleaseNotes>
	<PackageTags>ui;framework;skiasharp;code-only;gui;rendering</PackageTags>
	<PackageId>HandyUI.Controls</PackageId>
	<Version>$(AssemblyVersion)</Version>
	<Authors>davpnuser</Authors>
	<PackageIcon>HandyUI-Logo.png</PackageIcon>
	<NeutralLanguage>en</NeutralLanguage>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>NuGet-README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/davpnuser/HandyUI/</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://davpnuser.github.io/HandyUI/</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controls\CheckBox.cs" />
    <Compile Remove="Controls\Frame.cs" />
    <Compile Remove="Controls\ImageButton.cs" />
    <Compile Remove="Controls\ImageLabel.cs" />
    <Compile Remove="Controls\TextBox.cs" />
    <Compile Remove="Controls\TextButton.cs" />
    <Compile Remove="Controls\TextLabel.cs" />
  </ItemGroup>

  <ItemGroup>
		<None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
		<None Include="..\HandyUI-Logo.png" Pack="true" PackagePath="" Link="HandyUI-Logo.png" />
		<None Include="..\NuGet-README.md" Pack="true" PackagePath="" Link="NuGet-README.md" />
		<None Include="Controls\CheckBox.cs" />
		<None Include="Controls\Frame.cs" />
		<None Include="Controls\ImageButton.cs" />
		<None Include="Controls\ImageLabel.cs" />
		<None Include="Controls\TextBox.cs" />
		<None Include="Controls\TextButton.cs" />
		<None Include="Controls\TextLabel.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandyUI.Core\HandyUI.Core.csproj" />
  </ItemGroup>

</Project>
